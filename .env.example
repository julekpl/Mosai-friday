# Convex deployment URL - replace with your actual deployment URL
# Run 'npx convex dev' to get the development URL
VITE_CONVEX_URL=

# Convex site URL for auth
CONVEX_SITE_URL=http://localhost:5173

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

# Passwordless email delivery. Configure server-side in Convex, never with a
# VITE_ prefix and never commit the real value.
FREEBUFF_EMAIL_API_KEY=
VLY_APP_NAME=MOSAI

# AI gateway. Keep `vly` for the existing integration, or use `huggingface`
# with a fine-grained token allowed to call Inference Providers.
AI_PROVIDER=vly
VLY_INTEGRATION_KEY=
VLY_CHAT_MODEL=gpt-4o-mini
HF_TOKEN=
HF_CHAT_MODEL=openai/gpt-oss-120b:fastest
