# Convex deployment URL - replace with your actual deployment URL
# Run 'npx convex dev' to get the development URL
VITE_CONVEX_URL=

# Convex deployment site origin for auth and OAuth callback URLs.
# Use the HTTPS *.convex.site origin from your Convex dev deployment; this is
# not the dashboard URL. Convex provides this value to server functions.
CONVEX_SITE_URL=

# Trusted MOSAI dashboard/app origin used after OAuth returns.
# For local development, this is the Vite app origin:
ADS_OAUTH_REDIRECT_BASE=http://localhost:5173

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=
